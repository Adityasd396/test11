# This file is documentation; export values in your process/WSGI environment.
# Never upload a real .env or credentials in a release ZIP.
SOLACE_ENV=production
SOLACE_PUBLIC_URL=https://watch.example.com
SOLACE_SITE_NAME=Solace
SOLACE_CONTACT_EMAIL=support@example.com
SECRET_KEY=replace-with-a-unique-random-secret-at-least-32-characters
COOKIE_SECURE=1
HOST=127.0.0.1
PORT=8080
# Optional absolute persistent directory; leave unset to preserve the current instance/.
SOLACE_INSTANCE_PATH=
# Only enable behind one trusted reverse proxy that overwrites forwarded headers.
TRUST_PROXY=0
SOLACE_TRUST_X_REAL_IP=0
SOLACE_LOG_REQUESTS=1
# Readiness requires email unless a limited launch explicitly opts out.
SOLACE_REQUIRE_EMAIL=1
SOLACE_SMTP_HOST=
# Extra trusted submission hosts accepted by the private provider editor.
SOLACE_SMTP_ALLOWED_HOSTS=
SOLACE_SMTP_PORT=587
SOLACE_SMTP_SSL=0
SOLACE_SMTP_USERNAME=
SOLACE_SMTP_PASSWORD=
SOLACE_MAIL_FROM=
# Keep the existing server key/admin password file if already configured.
YOUTUBE_API_KEY=AIzaSyALoq1WXyV9eBpCsaegHY7QgvcOwIjHo7o
SOLACE_ADMIN_PASSWORD_HASH=

# Optional native build variable: public backend URL only, never a secret.
# EXPO_PUBLIC_API_URL=https://watch.example.com

# Named staff are enrolled locally using setup_staff.py; no default credentials.
# Discovery consent is off by default. Safety switches and storage controls persist in the admin dashboard.

# Media inspection automatically uses the platform's https_proxy/http_proxy.
# '*' permits any public HTTPS media origin through a validated IP tunnel.
# Add trusted provider hostnames only if your proxy requires hostname-based CONNECT.
# Unset uses the built-in trusted providers plus '*'.
SOLACE_MEDIA_PROXY_HOSTS=*
# Temporary room video uploads. Set the per-file limit to 0 to disable uploads.
SOLACE_ROOM_VIDEO_MAX_MIB=128
SOLACE_ROOM_VIDEO_STORAGE_MIB=1024

# Optional device notifications. Set these in the web app and dispatcher environment.
SOLACE_PUSH_PUBLIC_KEY=
SOLACE_PUSH_PRIVATE_KEY=
SOLACE_PUSH_CONTACT=

# Optional approved public HTTPS origins, separated by commas (for a domain change).
SOLACE_SITE_ORIGINS=
# Optional read-only reporting. Keep the service-account file outside the repository.
GOOGLE_APPLICATION_CREDENTIALS=
SOLACE_SEARCH_PROPERTY=
SOLACE_GA4_PROPERTY=
SOLACE_BACKUP_DIRECTORY=
